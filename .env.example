# Supabase / Vercel Postgres (auto-set when you connect Storage in Vercel)
POSTGRES_URL="postgres://...@...pooler.supabase.com:6543/postgres"
POSTGRES_URL_NON_POOLING="postgres://...@db....supabase.com:5432/postgres"

# POSTGRES_URL = pooled connection (app queries)
# POSTGRES_URL_NON_POOLING = direct connection (migrations only)
# The app adds ?pgbouncer=true automatically for pooled URLs.
