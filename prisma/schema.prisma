// Prisma schema for future database integration.
// Currently the app uses seed data in src/lib/data.ts for the MVP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id                  String    @id @default(cuid())
  name                String
  slug                String    @unique
  website             String?
  sources             String[]
  rating              Float     @default(0)
  reviewCount         Int       @default(0)
  warrantyMonths      Int       @default(0)
  warrantyDescription String
  location            String?
  logoInitials        String
  listings            Listing[]
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Product {
  id         String    @id @default(cuid())
  name       String
  slug       String    @unique
  brand      String
  category   String
  imageEmoji String?
  specs      Json
  listings   Listing[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Listing {
  id             String   @id @default(cuid())
  productId      String
  storeId        String
  price          Int
  currency       String   @default("AED")
  inStock        Boolean  @default(true)
  url            String?
  source         String
  warrantyMonths Int
  shippingCost   Int      @default(0)
  shippingDays   Int      @default(1)
  lastUpdated    DateTime
  product        Product  @relation(fields: [productId], references: [id])
  store          Store    @relation(fields: [storeId], references: [id])
  priceHistory   PriceHistory[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([productId])
  @@index([storeId])
}

model PriceHistory {
  id        String   @id @default(cuid())
  listingId String
  price     Int
  recordedAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])

  @@index([listingId, recordedAt])
}
